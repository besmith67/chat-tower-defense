{
  "name": "chat-tower-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tower defense game where the streamer defends and the chat attacks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance": "tsx tools/balance.ts",
    "playtest": "tsx tools/playtest.ts",
    "lexicon": "tsx tools/lexicon/build.ts"
  },
  "dependencies": {
    "obscenity": "^0.4.6",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "emojilib": "^4.0.3",
    "puppeteer-core": "^24.10.0",
    "subtlex-word-frequencies": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wordnet-db": "^3.1.14"
  },
  "engines": {
    "node": ">=20.19"
  }
}
